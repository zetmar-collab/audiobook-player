<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="MarekZettel-zetmar.PlayerAudiobook"
    Publisher="CN=15A53D32-C868-48EE-B700-5DBB5449CA1B"
    Version="1.2.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <!-- MUSI być dokładnie nazwą zarezerwowaną w Partner Center, inaczej
         walidacja pakietu odrzuca zgłoszenie. Nazwa widoczna dla użytkownika
         (kafelek, menu Start) ustawiana jest niżej w uap:VisualElements. -->
    <DisplayName>Player Audiobook</DisplayName>
    <PublisherDisplayName>Marek Zettel - zetmar</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pl-PL" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="AudiobookPlayer"
                 Executable="AudiobookPlayer.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Audiobook Player"
        Description="Odtwarzacz audiobooków z biblioteką, zapamiętywaniem pozycji odsłuchu i pobieraniem metadanych. / Audiobook player with a library, playback position memory and online metadata lookup."
        BackgroundColor="#2B6CB0"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          ShortName="Audiobook Player" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#2B6CB0" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- aplikacja desktopowa (pełne zaufanie) + dostęp do sieci na metadane -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
